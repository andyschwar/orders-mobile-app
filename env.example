# Supabase Database Configuration
# Copy this file to .env and fill in your actual values

# Supabase PostgreSQL connection string (use transaction pooler for IPv4 compatibility)
SUPABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Flask secret key for session management
SECRET_KEY=your-secret-key-change-this-in-production

# For local development, leave SUPABASE_URL empty to use SQLite
# SUPABASE_URL= 